# Let git decide text or binary, and normalise text to LF in the repository.
* text=auto

# Source and documents
*.rs text diff=rust
*.toml text
*.md text diff=markdown
*.json text
*.jmx text
*.xml text
*.svg text
*.groovy text
*.txt text

# Unix shell scripts must keep LF
*.sh text eol=lf

# Windows scripts and project files keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.ttf binary
*.png binary
*.ico binary
*.jar binary
*.zip binary
